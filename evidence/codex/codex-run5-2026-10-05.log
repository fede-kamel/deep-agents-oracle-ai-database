from pathlib import Path
import json, re
repo = Path('.').resolve()
config = Path.home() / '.config' / 'deepagents-oracle-health' / 'config.json'
service_tokens = []
if config.exists():
    data = json.loads(config.read_text())
    for key in ('dsn', 'connect_string'):
        val = str(data.get(key, ''))
        if '/' in val:
            tail = val.rsplit('/', 1)[-1].strip()
            if tail:
                service_tokens.append(tail)
patterns = [
    ('OCID', re.compile(r'ocid1\\.', re.I)),
    ('private key block', re.compile(r'[REDACTED-KEY-HEADER]')),
    ('API key fingerprint field', re.compile(r'fingerprint\\s*[=:]', re.I)),
]
for token in service_tokens:
    patterns.append(('DSN service name', re.compile(re.escape(token))))
skip_dirs = {'.git', '.venv', 'node_modules', '__pycache__'}
findings = []
for path in repo.rglob('*'):
    if path.is_dir():
        continue
    if any(part in skip_dirs for part in path.parts):
        continue
    try:
        text = path.read_text(errors='ignore')
    except Exception:
        continue
    for label, pat in patterns:
        if pat.search(text):
            findings.append((label, str(path.relative_to(repo))))
if findings:
    print('SECRET-SCAN FAIL')
    for label, rel in findings[:20]:
        print(f'{label}: {rel}')
    if len(findings) > 20:
        print(f'... {len(findings)-20} more')
    raise SystemExit(1)
print('SECRET-SCAN OK')
