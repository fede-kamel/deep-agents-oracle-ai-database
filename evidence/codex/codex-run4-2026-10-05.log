) REFERENCES da_owner.patient (patient_id), \n\tCONSTRAINT sys_c0036719 FOREIGN KEY(encounter_id) REFERENCES da_owner.encounter (id)\n)\n TABLESPACE \"DATA\"\n\n/*\n2 rows from clinical_note table:\nid\tpatient_id\tencounter_id\tnote_date\tkind\tbody\tnote_ref\n8\tSYN-Y\t405\t2026-06-03 00:00:00\tHospital admission\tAdmitted with dyspnoea and leg oedema. BNP 980. Diuresed with IV furosemide, 3.1 kg net loss. Echo E\tSYN-Y-NOTE-0008\n9\tSYN-Y\t406\t2026-07-19 00:00:00\tHospital readmission\tReadmitted 41 days after discharge with orthopnoea. Patient explains she stopped the afternoon furos\tSYN-Y-NOTE-0009\n*/\n\n\nCREATE TABLE \"DA_OWNER\".cohort_benchmark (\n\tcohort VARCHAR(64 CHAR) NOT NULL, \n\tmetric VARCHAR(64 CHAR) NOT NULL, \n\tpatients INTEGER NOT NULL, \n\tp10 NUMBER(10, 2), \n\tp50 NUMBER(10, 2), \n\tp90 NUMBER(10, 2), \n\tunit VARCHAR(32 CHAR), \n\tdescription VARCHAR(256 CHAR), \n\tCONSTRAINT sys_c0036754 PRIMARY KEY (cohort, metric)\n)\n TABLESPACE \"DATA\"\n\n/*\n2 rows from cohort_benchmark table:\ncohort\tmetric\tpatients\tp10\tp50\tp90\tunit\tdescription\nType 2 diabetes\teGFR change per year\t160\t-5.88\t-2.75\t0.99\tmL/min/1.73m2 per year\tPer-patient linear trend (REGR_SLOPE) of eGFR in the background diabetes cohort\nType 2 diabetes\tLatest HbA1c\t160\t6.2\t7.3\t8 ..."}
